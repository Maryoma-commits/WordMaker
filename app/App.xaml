<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WordMaker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Gold from the logo: deepened for light theme readability,
                     brightened to stay visible on dark Mica. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LogoAccentBrush" Color="#8A6420"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LogoAccentBrush" Color="#DDBA75"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
